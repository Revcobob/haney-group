{
  "expo": {
    "name": "CareDose",
    "slug": "caredose-clean",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caredose",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF6F0",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "CareDose uses the camera so you can photograph discharge papers, prescriptions, and pill bottles.",
        "NSPhotoLibraryUsageDescription": "CareDose uses your photo library so you can attach photos of instructions and medications.",
        "NSMicrophoneUsageDescription": "CareDose does not record audio; this permission is required by the camera module."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "care-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "CareDose uses the camera so you can photograph discharge papers, prescriptions, and pill bottles."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
