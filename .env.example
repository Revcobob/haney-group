# Copy to .env.local and fill in. Placeholders only — never commit a real
# key here; the real values live in Vercel's environment settings.
# These are the only env vars the app uses; everything else is hardcoded.

# ---------- Clerk (admin auth) ----------
# Get from https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Comma-separated list of email addresses allowed into /admin/*.
# Clerk authenticates; this list authorizes.
# Example: ADMIN_EMAILS=robert@haney-group.com,julie@haney-group.com,info@haney-group.com
ADMIN_EMAILS=info@haney-group.com

# Where Clerk should send users to sign in / land after sign-in.
# These have sensible defaults; usually no need to override.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin/dashboard

# ---------- Supabase (CMS data + storage) ----------
# Project URL and anon key from https://supabase.com/dashboard project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only in /api/admin/* and server actions.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---------- Email notifications (Phase 6) ----------
# info@haney-group.com ALWAYS receives inquiry alerts. These add recipients
# on top of it (comma-separated); Site Settings -> "Notification recipients"
# does the same from the CMS.
CONTACT_NOTIFICATION_EMAIL=info@haney-group.com
# The From address. Its domain must be verified in Resend or every send is
# rejected. Verify haney-group.com at https://resend.com/domains.
CONTACT_FROM_EMAIL=The Haney Group Website <noreply@haney-group.com>
# Resend API key, https://resend.com/api-keys. Optional in Phase 3.
RESEND_API_KEY=re_your_key_here
