# Copy to .env.local and fill in.
# These are the only env vars the app uses; everything else is hardcoded.

# ---------- Clerk (admin auth) ----------
# Get from https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of email addresses granted FULL admin access to
# /admin/*: everything an editor can do, plus Site Settings, Navigation,
# page publish status, and row deletes.
# Clerk authenticates; this list authorizes.
# Example: ADMIN_EMAILS=robert@haney-group.com,julie@haney-group.com,info@haney-group.com
ADMIN_EMAILS=you@example.com

# Content-only access. Editors can edit pages, sections, services, industries,
# experience, clients, articles, media, inquiries, and SEO -- but NOT Site
# Settings, Navigation, page publish status, or row deletes. Those four
# redirect an editor to /admin/forbidden?need=admin.
#
# Same format as ADMIN_EMAILS: comma-separated, case-insensitive, and
# whitespace around each address is ignored. Commas are the only separator.
# An address on both lists gets full admin -- ADMIN_EMAILS is checked first.
# Leave blank when there are no editor-only users.
# Example: ADMIN_EDITORS=assistant@haney-group.com,contractor@example.com
ADMIN_EDITORS=

# Where Clerk should send users to sign in / land after sign-in.
# These have sensible defaults; usually no need to override.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin/dashboard

# ---------- Supabase (CMS data + storage) ----------
# Project URL and anon key from https://supabase.com/dashboard project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx.xxxxx
# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only in /api/admin/* and server actions.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx.xxxxx

# ---------- Email notifications (Phase 6) ----------
# Inquiry alerts go to this address. Defaults to info@haney-group.com if unset.
CONTACT_NOTIFICATION_EMAIL=info@haney-group.com
# Resend API key, https://resend.com/api-keys. Optional in Phase 3.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
